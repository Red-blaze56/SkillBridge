# Copy to deploy/.env.prod on the server and fill in. Never commit deploy/.env.prod.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# The address students open, exactly (scheme, host, and port if not 80/443).
# Requests that change data must come from it, and sign-in cookies are HTTPS-only.
APP_ORIGIN=https://skillbridge.example.com

# Where Nginx listens on the server (ignored with compose.tunnel.yaml, which publishes nothing).
HTTP_PORT=80

# Gemini API key for skill analyses and mock interviews: https://aistudio.google.com/apikey
# A free key allows about 20 requests a day per model; an analysis uses 2-4.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Shared secret between the API and the interview service (at least 32 characters).
INTERVIEW_SERVICE_TOKEN=

# RabbitMQ and the interview service's Postgres. Long random values.
RABBITMQ_USER=skillbridge
RABBITMQ_PASSWORD=
INTERVIEW_DB_PASSWORD=

# Optional limits per student per day
# INTERVIEWS_PER_DAY=3
# ANALYSES_PER_DAY=10

# Only with compose.tunnel.yaml: the token from Cloudflare Zero Trust → Networks → Tunnels.
# TUNNEL_TOKEN=
