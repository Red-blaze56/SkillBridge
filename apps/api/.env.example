# Copy to apps/api/.env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge?directConnection=true

# Where the web app runs. Only it may send requests that change data.
APP_ORIGIN=http://localhost:5173

# Reverse proxies in front of the API: 0 locally, 1 behind Nginx.
TRUST_PROXY=0

# The mock-interview service. Its shared token, INTERVIEW_SERVICE_TOKEN, lives in the
# repo-root .env, which this API also reads.
# INTERVIEW_SERVICE_URL=http://127.0.0.1:8100
# INTERVIEWS_PER_DAY=3
