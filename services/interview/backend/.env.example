# Only needed to run the service outside Docker (e.g. `uv run uvicorn app.main:app`).
# Inside SkillBridge, compose.yaml passes these values from the repo-root .env.

DATABASE_URL=postgresql+asyncpg://interview:interview-dev@localhost:5432/interview

# Shared secret with SkillBridge's API, at least 32 characters.
# Must equal INTERVIEW_SERVICE_TOKEN in SkillBridge's root .env.
SERVICE_TOKEN=

LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
