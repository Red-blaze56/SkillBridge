# secrets
.env

# data/ holds your resume, the profile made from it, and the dedupe index
# (seen.json) + company strikes (matcher_state.json). Personal, and it must
# never ship with the repo: a cloned seen.json marks every job as already-seen,
# so a new user's first run finds nothing.
data/
resume.*
profile.json
!profile.example.json
seen.json
matcher_state.json

# generated output
out/
*.html
!jobhunt/templates/*.html

# python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db
