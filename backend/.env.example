# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# --- Server ---
PORT=5000
FRONTEND_URL=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge

# --- Login tokens ---
# Any long random string, e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- AI (resume analysis, Skill Gap Analyzer, Learning Roadmap) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Job Finder agent (optional) ---
# Free keys: https://developer.adzuna.com. Leave empty to use the built-in sample jobs.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code for the search (in = India, gb, us, ...) and an optional city
ADZUNA_COUNTRY=in
ADZUNA_LOCATION=
