# Copy to .env (next to compose.yaml). Docker Compose and SkillBridge's API both
# read it. Never commit .env.

# Gemini API key for the interview service: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Shared secret between SkillBridge's API and the interview service, at least 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERVIEW_SERVICE_TOKEN=

# Password for the interview service's own Postgres (default for local use: interview-dev)
# INTERVIEW_DB_PASSWORD=
